extends "res://tests/test_gui_input.gd"

func run() -> void:
	root.gui_embed_subwindows = true
	cafe = load("res://scenes/cafe.tscn").instantiate()
	root.add_child(cafe)
	if OS.get_environment("VAC_GUI_RENDERED") == "1":
		cafe.world.hide()
	await frames(12)
	var ui = cafe.management
	ui.poll.stop()
	await settled(ui)
	check(ui.visible and ui.tabs.current_tab == 4, "Starter opens wizard automatically")
	check(ui.chosen(ui.setup_project) == "wizard-project", "Starter preselects mounted project")
	await click(ui.buttons["Close"])
	var entry: Button
	for node in cafe.find_children("*", "Button", true, false):
		if node.text == "Manage agents":
			entry = node
	await click(entry)
	await settled(ui)
	await click(ui.buttons["Setup project"])
	await settled(ui)
	check(ui.tabs.current_tab == 4, "Project setup opens through pointer")
	check(ui.setup_project.item_count == 1, "Approved source repositories listed")
	check(ui.buttons["Create backend + frontend team"].disabled, "Cannot create before checks")
	await type_text(ui.setup_objective, "Build an API and matching frontend. Share the task contract.")
	await click(ui.buttons["Load project documents"])
	await settled(ui)
	check(ui.setup_document_editor.text.begins_with("#"), "Missing AGENTS document gets editable template")
	ui.setup_file_dialog.use_native_dialog = false # Headless fixture uses the equivalent embedded chooser.
	await click(ui.buttons["Import Markdown file"])
	await frames()
	check(ui.setup_file_dialog.visible, "Import button opens file chooser")
	ui.setup_file_dialog.get_line_edit().grab_focus()
	for character in OS.get_environment("VAC_GUI_IMPORT_FILE"):
		await key(0, character.unicode_at(0))
	await key(KEY_ENTER)
	await frames(8)
	check(not ui.setup_file_dialog.visible, "File chosen through keyboard input")
	check(ui.setup_document_editor.text.begins_with("# Imported project agents"), "Selected file imported into editor")
	check(not ui.setup_documents["AGENTS.md"].exists, "Import does not write project until explicit save")
	await click(ui.buttons["Save project document"])
	await settled(ui)
	check(ui.setup_documents["AGENTS.md"].exists, "AGENTS.md saved through actual GUI input")
	await select_option(ui.setup_document, 1)
	await type_text(ui.setup_document_editor, "# Project planning\n- Implement API\n- Implement frontend\n- Run integration tests")
	await click(ui.buttons["Save project document"])
	await settled(ui)
	check(ui.setup_documents["PLANNING.md"].exists, "PLANNING.md saved through actual GUI input")
	await click(ui.buttons["Load project documents"])
	await settled(ui)
	check(ui.setup_document_editor.text.contains("Run integration tests"), "Project document reload preserves saved text")
	# Reproduce the previously invisible 409: remote checks need server opt-in.
	await click(ui.setup_remote)
	await click(ui.buttons["Check project"])
	check(ui.setup_result.text.contains("Checking"), "Click immediately shows a pending project check")
	await settled(ui)
	check(ui.setup_status.text.contains("Enable remote checks"), "Check failure stays visible above the scrolling report")
	check(ui.setup_result.text.contains("Enable remote checks"), "Rejected checks show the error in the report")
	check(ui.buttons["Create backend + frontend team"].disabled, "Failed check cannot create a team")
	await click(ui.setup_remote)
	# The loaded plan is sufficient: no redundant objective text is needed.
	await type_text(ui.setup_objective, "")
	await click(ui.buttons["Check project"])
	await settled(ui)
	check(ui.setup_ready, "Real namespace and repository checks pass with fixture login")
	check(ui.setup_result.text.contains("PASS"), "Readiness report visible")
	check(not ui.buttons["Create backend + frontend team"].disabled, "Ready team can be created from the loaded plan without a redundant goal")
	check(ui.setup_status.text.contains("PLANNING.md"), "Report explains the goal inferred from the loaded plan")
	await click(ui.setup_integrate)
	check(ui.setup_publish.button_pressed, "Automatic integration also enables worker publication")
	await click(ui.buttons["Create backend + frontend team"])
	await settled(ui)
	check(ui.setup_result.text.contains("--publish-results"), "Publishing requires explicit controller capability")
	check(ui.cache.agents.is_empty(), "Denied publication does not silently create a local-only team")
	await click(ui.setup_integrate)
	await click(ui.setup_publish)
	await click(ui.buttons["Create backend + frontend team"])
	await settled(ui)
	check(ui.setup_result.text.contains("TEAM READY"), "Creation result is shown")
	check(ui.cache.agents.size() == 2, "Both agents persist via API")
	for agent in ui.cache.agents:
		check(agent.state == "CONFIGURED", "Setup never starts model tasks")
		check(not agent.config.git.allow_push, "Push disabled by default")
		check(agent.config.git.worktree, "Separate worktree for each agent")
	await tab(ui, 0)
	check(ui.agents.item_count == 2, "Team appears in original agent management")
	await click(ui.agents, Vector2(35, 20))
	await frames()
	check(not ui.active_agent.is_empty(), "Generated agent can be selected for review")
	await click(ui.buttons["Close"])
	check(not ui.visible, "Wizard can be closed")
	cafe.queue_free()
	await frames()
	print("Godot project setup input tests: PASS (", checks, " checks)")
	quit(0)
